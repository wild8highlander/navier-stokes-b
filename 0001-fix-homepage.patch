From 1095b8b535d498bc988ba74a7feef1e5b4366772 Mon Sep 17 00:00:00 2001
From: wild8highlander <твоя@почта.com>
Date: Wed, 16 Sep 2026 16:25:37 +0000
Subject: [PATCH] fix(homepage): make the root README render again; repo
 hygiene

- rename .github/README.md -> .github/AUTOMATION.md: GitHub renders
  .github/README.md on the repository homepage INSTEAD of the root
  README.md, which hid the banner and all badges
- exempt the top-level .github/ dir from the docs-hygiene README rule
  (check_readmes.py) and document why
- delete stray 'how --stat 973690b' file (accidental git-output capture)
- add assets/social-preview.png (1280x640) for Settings -> Social preview
- regenerate MANIFEST.json (sha256) after the tree change

Local checks: verify_manifest.py 388/388 OK, check_readmes.py OK
---
 .github/{README.md => AUTOMATION.md} |   0
 .github/scripts/check_readmes.py     |   9 +-
 MANIFEST.json                        |  16 +--
 assets/social-preview.png            | Bin 0 -> 258907 bytes
 how --stat 973690b                   | 143 ---------------------------
 5 files changed, 18 insertions(+), 150 deletions(-)
 rename .github/{README.md => AUTOMATION.md} (100%)
 create mode 100644 assets/social-preview.png
 delete mode 100644 how --stat 973690b

diff --git a/.github/README.md b/.github/AUTOMATION.md
similarity index 100%
rename from .github/README.md
rename to .github/AUTOMATION.md
diff --git a/.github/scripts/check_readmes.py b/.github/scripts/check_readmes.py
index e9c7904..458db6d 100644
--- a/.github/scripts/check_readmes.py
+++ b/.github/scripts/check_readmes.py
@@ -1,5 +1,10 @@
 #!/usr/bin/env python3
-"""Docs hygiene: every directory must have a README; no Cyrillic in any README."""
+"""Docs hygiene: every directory must have a README; no Cyrillic in any README.
+
+Note: the top-level .github/ directory is exempt from the README requirement.
+GitHub renders .github/README.md on the repository homepage INSTEAD of the
+root README.md, so .github/ carries AUTOMATION.md (not a README) on purpose.
+"""
 import pathlib
 import re
 import sys
@@ -13,6 +18,8 @@ def main() -> int:
     for d in sorted(p for p in ROOT.rglob("*") if p.is_dir()):
         if any(part in {".git", "node_modules", "__pycache__"} for part in d.parts):
             continue
+        if d == ROOT / ".github":
+            continue
         if not any(d.glob("README*")):
             no_readme.append(d.relative_to(ROOT).as_posix() or ".")
     for md in sorted(ROOT.rglob("README*.md")):
